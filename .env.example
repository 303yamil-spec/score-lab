# SportyBet MCP configuration
# Only configuration actually required by the service is listed here.
# The SportyBet web API used by this MCP is public and unauthenticated:
# no API key or credentials are required. See README.md "API source".

# Region code for SportyBet (ng = Nigeria). Controls the country-scoped API path.
SPORTYBET_REGION=ng

# Base URL of the SportyBet web API. Change only if SportyBet moves it.
SPORTYBET_API_BASE_URL=https://www.sportybet.com

# Request timeout in milliseconds.
SPORTYBET_TIMEOUT_MS=15000

# Optional API key for a future third-party provider.
# Only set if you swap in a provider that actually requires one.
SPORTYBET_API_KEY=

# Optional football-data.org token for historical team and league results.
# Create a token at https://www.football-data.org/client/register
# Without it, predictions fall back to clearly labelled SportyBet market-implied estimates.
FOOTBALL_DATA_API_KEY=

# Local prediction website settings.
APP_HOST=127.0.0.1
APP_PORT=4173
APP_REFRESH_MINUTES=15
PREDICTION_MAX_GOALS=10
# Optional absolute or relative SQLite path. Default: ./data/predictions.sqlite
# PREDICTIONS_DB_PATH=data/predictions.sqlite